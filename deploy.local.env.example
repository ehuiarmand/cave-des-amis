# Copier ce fichier vers deploy.local.env (non versionné) et adapter.
# Prérequis : clé SSH déjà utilisable avec : ssh DEPLOY_USER@DEPLOY_HOST

DEPLOY_HOST=72.62.21.25
DEPLOY_USER=root
DEPLOY_PATH=/var/www/cave-des-amis

# Optionnel : redémarrer le service Python après copie (systemd)
RESTART_SERVICE=cave-des-amis

# HTTPS : cookie de session Secure (recommandé en production)
# MAQUIS_MANAGER_COOKIE_SECURE=1

# WhatsApp Cloud API (Meta) — alertes commandes QR / serveuses en service
# WHATSAPP_PHONE_NUMBER_ID=<ID de votre numéro WhatsApp Cloud>
# WHATSAPP_ACCESS_TOKEN=<jeton d'accès Graph API>
# WHATSAPP_TEMPLATE_NAME=<nom du template facultatif, sinon message texte simple>
# WHATSAPP_TEMPLATE_LANG=fr

# E-mail quotidien — point des ventes (SMTP)
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=587
# SMTP_USER=rapport@votredomaine.com
# SMTP_PASSWORD=<mot de passe boîte mail>
# SMTP_FROM=Cave des Amis <rapport@votredomaine.com>
# SMTP_TLS=1
# Optionnel : destinataires de secours si le maquis n'a pas d'adresses
# EMAIL_DAILY_TO=gerant@exemple.com


# --- Paiement Wave (commande QR + ticket) — voir wave_pay.py ---
# Un compte Wave par maquis : suffixe = id du maquis en MAJUSCULES, « - » remplacé par « _ »
#   maquis-1 -> __MAQUIS_1   maquis-3 -> __MAQUIS_3   NO-STRESS -> __NO_STRESS
# Un maquis qui a au moins une variable suffixée n'utilise JAMAIS les variables sans suffixe.
# Repli sans API : lien du QR marchand statique (pas de confirmation automatique).
# WAVE_MERCHANT_URL__MAQUIS_1=https://pay.wave.com/m/M_ci_xxxx/c/ci/
# Mode API (confirmation automatique), quand Wave active l'onglet Développeur du compte :
# WAVE_API_KEY__MAQUIS_1=wave_ci_prod_...
# WAVE_WEBHOOK_SECRET__MAQUIS_1=wave_sn_WHS_...     (option « Signing secret », recommandée)
# WAVE_WEBHOOK_SHARED_SECRET__MAQUIS_1=...          (alternative « Shared secret »)
# WAVE_SIGNING_SECRET__MAQUIS_1=wave_sn_AKS_...     (seulement si activé sur la clé)
#   Webhook à déclarer sur chaque compte : https://votre-domaine.example/api/wave/webhook
# Communs à tous les maquis :
# WAVE_PUBLIC_BASE_URL=https://votre-domaine.example
# WAVE_CURRENCY=XOF
# MAQUIS_WAVE_STORE=/var/www/.../wave_payments.json
