# Copier ce fichier vers deploy.local.env (non versionné) et adapter.
# Prérequis : clé SSH déjà utilisable avec : ssh DEPLOY_USER@DEPLOY_HOST

DEPLOY_HOST=72.62.21.25
DEPLOY_USER=root
DEPLOY_PATH=/var/www/cave-des-amis

# Optionnel : redémarrer le service Python après copie (systemd)
RESTART_SERVICE=cave-des-amis

# HTTPS : cookie de session Secure (recommandé en production)
# MAQUIS_MANAGER_COOKIE_SECURE=1

# WhatsApp Cloud API (Meta) — alertes commandes QR / serveuses en service
# WHATSAPP_PHONE_NUMBER_ID=<ID de votre numéro WhatsApp Cloud>
# WHATSAPP_ACCESS_TOKEN=<jeton d'accès Graph API>
# WHATSAPP_TEMPLATE_NAME=<nom du template facultatif, sinon message texte simple>
# WHATSAPP_TEMPLATE_LANG=fr

# E-mail quotidien — point des ventes (SMTP)
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=587
# SMTP_USER=rapport@votredomaine.com
# SMTP_PASSWORD=<mot de passe boîte mail>
# SMTP_FROM=Cave des Amis <rapport@votredomaine.com>
# SMTP_TLS=1
# Optionnel : destinataires de secours si le maquis n'a pas d'adresses
# EMAIL_DAILY_TO=gerant@exemple.com
